# ------------------------------------------------------------------
# ALL IN ONE CLEANING — environment variables
# Kopieer naar .env.local (lokaal) en zet dezelfde keys in Vercel.
# NOOIT committen: .env.local staat in .gitignore.
# ------------------------------------------------------------------

# Publieke site-URL (zonder trailing slash) — voor canonical, OG, sitemap
NEXT_PUBLIC_SITE_URL=https://www.allinonecleaning-enschede.nl

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Alleen server-side! Wordt gebruikt in route handlers voor inserts en uploads.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (e-mail) — https://resend.com
RESEND_API_KEY=re_...
# Afzender. Domein moet geverifieerd zijn in Resend. Tijdens testen: onboarding@resend.dev
EMAIL_FROM="All in One Cleaning <offerte@allinonecleaning-enschede.nl>"
# Waar nieuwe aanvragen en contactberichten naartoe gaan
QUOTE_NOTIFICATION_EMAIL=info@example.nl
# Bevestigingsmail naar de klant (true/false, standaard true)
SEND_CUSTOMER_CONFIRMATION=true

# Optioneel: basis-URL van een later dashboard → "Bekijk aanvraag"-link in de notificatiemail
# ADMIN_URL=https://admin.allinonecleaning-enschede.nl

# Optioneel: salt voor het hashen van IP-adressen (AVG). Willekeurige lange string.
IP_HASH_SALT=verander-dit-in-een-lange-willekeurige-string

# Optioneel: hero-video (Higgsfield). Pad in /public of volledige URL. Leeg = statische poster.
# NEXT_PUBLIC_HERO_VIDEO_SRC=/videos/hero.mp4
