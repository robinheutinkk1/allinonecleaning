# ------------------------------------------------------------------
# NOVA ONDERHOUD (TagPoint demo-website) - environment variables
# Kopieer naar .env.local (lokaal) en zet dezelfde keys in de hostingomgeving.
# NOOIT committen: .env.local staat in .gitignore.
# ------------------------------------------------------------------

# Publieke site-URL (zonder trailing slash) - voor canonical, OG, sitemap
NEXT_PUBLIC_SITE_URL=https://www.novademo.nl

# Database en opslag (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Alleen server-side! Wordt gebruikt in route handlers voor inserts en uploads.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# E-mail (Resend) - https://resend.com
RESEND_API_KEY=re_...
# Afzender. Domein moet geverifieerd zijn. Tijdens testen: onboarding@resend.dev
EMAIL_FROM="NOVA Onderhoud <offerte@novademo.nl>"
# Waar nieuwe aanvragen en contactberichten naartoe gaan (demo-adres)
QUOTE_NOTIFICATION_EMAIL=demo@tagpoint.nl
# Bevestigingsmail naar de klant (true/false, standaard true)
SEND_CUSTOMER_CONFIRMATION=false

# Dashboard (/admin). Alleen deze e-mailadressen (Auth-gebruikers) mogen inloggen.
# Meerdere adressen scheiden met een komma. Leeg = niemand kan inloggen.
ADMIN_EMAILS=demo@tagpoint.nl

# Optioneel: basis-URL van het dashboard voor de "Bekijk aanvraag"-link in de notificatiemail.
# Standaard: NEXT_PUBLIC_SITE_URL + /admin
# ADMIN_URL=https://www.novademo.nl/admin

# Demo: de publieke site gebruikt standaard alleen de demo-inhoud uit config/
# (contactgegevens, reviews, projecten). Zet op true om de inhoud uit het dashboard
# (database) leidend te maken, zoals bij een echte klantwebsite.
# DEMO_USE_DATABASE_CONTENT=true

# Optioneel: Google-reviews automatisch ophalen (Places API (New), zie docs/DEPLOYMENT.md)
# Niet gebruikt in de demo.
# GOOGLE_PLACES_API_KEY=AIza...
# GOOGLE_PLACE_ID=ChIJ...
# CRON_SECRET=verander-dit-in-een-lange-willekeurige-string

# Optioneel: salt voor het hashen van IP-adressen (AVG). Willekeurige lange string.
IP_HASH_SALT=verander-dit-in-een-lange-willekeurige-string

# Optioneel: hero-video. Pad in /public of volledige URL. Leeg = statische poster.
# NEXT_PUBLIC_HERO_VIDEO_SRC=/videos/hero.mp4
